{minimum_otp_vsn, "27"}.

{deps, [
  {cowboy, "~>2.20.0"},
  jsx,
  {jiffy, "~>2.0.2"},
  {jesse, "~>1.8.2"},
  erlydtl,
  lager,
  meck,
  redbug,
  epipe
]}.

{plugins, [
  {rebar3_erlydtl_plugin, ".*", {git, "https://github.com/tsloughter/rebar3_erlydtl_plugin.git", {branch, "master"}}},
  rebar3_format
]}.

{provider_hooks, [
  {pre, [{compile, {erlydtl, compile}}]}
]}.

{dialyzer, [{plt_apps, all_deps}]}.

{erl_opts,
  [
    debug_info,
    warn_export_vars,
    warn_shadow_vars,
    warn_obsolete_guard,
    {parse_transform,lager_transform}
  ]}.

{erlydtl_opts, [
               {doc_root,   "templates"}
  ]}.


{format, [
    {files, ["src/*.erl", "test/*.erl"]},
    {formatter, default_formatter},
    {options, #{
                inline_clause_bodies => true,
                inline_simple_funs => true,
                inline_items => none,
                inline_attributes => none,
                inline_fields => none,
                spaces_around_fields => false
            }}
]}.
